{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bancadalab-sus",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": ".next",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bancadalab_db",
      "database_id": "bancadalab-d1-production"
    }
  ]
}

